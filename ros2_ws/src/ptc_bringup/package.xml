<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ptc_bringup</name>
  <version>0.1.0</version>
  <description>Launch and deployment configuration for PickTurnCheck.</description>
  <maintainer email="mortcj0@gmail.com">MortCat</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ptc_app</exec_depend>
  <exec_depend>ptc_mock</exec_depend>
  <exec_depend>ptc_vision</exec_depend>
  <exec_depend>ptc_inference</exec_depend>
  <exec_depend>ptc_task</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
