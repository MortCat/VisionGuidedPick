            rel material:binding:physics = </LInlet/Looks/Contact>
            bool physics:kinematicEnabled = 1
            vector3f physxSurfaceVelocity:surfaceVelocity = (-0.06, 0, 0)
            bool physxSurfaceVelocity:surfaceVelocityEnabled = 1
            bool physxSurfaceVelocity:surfaceVelocityLocalSpace = 0
            double size = 1
            float3 xformOp:scale = (1.75, 0.35, 0.03)
