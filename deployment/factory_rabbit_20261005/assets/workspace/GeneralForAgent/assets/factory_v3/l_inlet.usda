#usda 1.0
(
    defaultPrim = "LInlet"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "LInlet"
{
    custom int conveyor:curveSegments = 32
    custom float conveyor:speed = 0.06

    def "Looks"
    {
        def Material "BrushedSteel"
        {
            token outputs:surface.connect = </LInlet/Looks/BrushedSteel/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.48, 0.52, 0.55)
                float inputs:metallic = 0.45
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "RubberBelt"
        {
            token outputs:surface.connect = </LInlet/Looks/RubberBelt/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.028, 0.033, 0.037)
                float inputs:metallic = 0
                float inputs:roughness = 0.88
                token outputs:surface
            }
        }

        def Material "SafetyYellow"
        {
            token outputs:surface.connect = </LInlet/Looks/SafetyYellow/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.62, 0.04)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "Contact" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.75
            float physics:restitution = 0
            float physics:staticFriction = 0.9
        }
    }

    def "Straight"
