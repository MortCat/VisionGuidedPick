        def Material "Aluminium"
        {
            token outputs:mdl:surface.connect = </ConveyorDetail/Looks/Aluminium/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.52, 0.56, 0.6)
                float inputs:metallic_constant = 1
                float inputs:reflection_roughness_constant = 0.3
                float inputs:round_edges_radius = 0.001
