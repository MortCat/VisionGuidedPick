#usda 1.0
(
    defaultPrim = "ObservationGantry"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "ObservationGantry" (
    assetInfo = {
        string name = "Upstream RGB-D observation gantry"
        string version = "1.0"
    }
)
{
    custom string gantry:purpose = "upstream discovery and first-arm visual handover; no moving axes"
    custom string gantry:revision = "fixed_portal_d455_v1_20261012"

    def "Looks"
    {
        def Material "BrushedStainless"
        {
            token outputs:surface.connect = </ObservationGantry/Looks/BrushedStainless/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.56, 0.6, 0.64)
                float inputs:metallic = 0.85
                float inputs:roughness = 0.29
                token outputs:surface
            }
        }

        def Material "SatinMountingSteel"
        {
            token outputs:surface.connect = </ObservationGantry/Looks/SatinMountingSteel/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.37, 0.42, 0.47)
                float inputs:metallic = 0.75
                float inputs:roughness = 0.38
                token outputs:surface
            }
        }

        def Material "Fasteners"
        {
            token outputs:surface.connect = </ObservationGantry/Looks/Fasteners/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.22, 0.26, 0.29)
                float inputs:metallic = 0.9
                float inputs:roughness = 0.25
                token outputs:surface
            }
        }

        def Material "CableAndPads"
        {
            token outputs:surface.connect = </ObservationGantry/Looks/CableAndPads/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.019, 0.024, 0.029)
                float inputs:metallic = 0.05
                float inputs:roughness = 0.68
                token outputs:surface
            }
        }

        def Material "InstrumentBlue"
        {
            token outputs:surface.connect = </ObservationGantry/Looks/InstrumentBlue/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.025, 0.23, 0.33)
                float inputs:metallic = 0.35
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "Label"
        {
            token outputs:surface.connect = </ObservationGantry/Looks/Label/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </ObservationGantry/Looks/Label/Texture.outputs:rgb>
                float inputs:roughness = 0.55
                token outputs:surface
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @gantry_label.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </ObservationGantry/Looks/Label/UV.outputs:result>
                color3f outputs:rgb
            }

            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
        }
    }

