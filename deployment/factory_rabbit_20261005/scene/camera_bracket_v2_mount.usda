#usda 1.0

def "World"
{
    def "FactoryDemo"
    {
        def "Robots"
        {
            def "arm_01"
            {
                over "WristD455"
                {
                    matrix4d xformOp:transform = ( (0.2596339763109178, -2.1550688881172347e-7, 0.9657070975947809, 0), (0.000001549639121925946, 0.9999999999987808, -1.9346660983072564e-7, 0), (-0.9657070975935614, 0.0000015467280039481744, 0.2596339763109352, 0), (0.5066290492460795, -1.646507802322006e-7, 0.5255144536804838, 1) )
