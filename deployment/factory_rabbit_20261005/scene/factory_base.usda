        def "ROS"
        {
            def OmniGraph "arm_01"
            {
                token evaluationMode = "Automatic"
                token evaluator:type = "execution"
                token fabricCacheBacking = "StageWithoutHistory"
                int2 fileFormatVersion = (1, 9)
                token pipelineStage = "pipelineStageSimulation"

                def OmniGraphNode "Tick"
                {
                    token node:type = "omni.graph.action.OnPlaybackTick"
                    int node:typeVersion = 2
                    custom double outputs:deltaSeconds
                    custom double outputs:frame
                    custom uint outputs:tick (
                        customData = {
                            bool isExecution = 1
                        }
                    )
                    custom double outputs:time
                }

                def OmniGraphNode "Time"
                {
                    custom uint64 inputs:referenceTimeDenominator
                    custom int64 inputs:referenceTimeNumerator
                    custom bool inputs:resetOnStop
                    token node:type = "isaacsim.core.nodes.IsaacReadSimulationTime"
                    int node:typeVersion = 1
                    custom double outputs:simulationTime
                }

                def OmniGraphNode "Context"
                {
                    custom uchar inputs:domain_id = 0
                    custom bool inputs:useDomainIDEnvVar
                    token node:type = "isaacsim.ros2.bridge.ROS2Context"
                    int node:typeVersion = 2
                    custom uint64 outputs:context
                }

                def OmniGraphNode "ReadJoints"
                {
                    custom uint inputs:execIn (
                        customData = {
                            bool isExecution = 1
                        }
                    )
                    prepend uint inputs:execIn.connect = </World/FactoryDemo/ROS/arm_01/Tick.outputs:tick>
                    custom rel inputs:prim = </World/FactoryDemo/Robots/arm_01> (
                        customData = {
                            dictionary omni = {
                                dictionary graph = {
                                    string relType = "target"
                                }
                            }
                        }
                    )
                    token node:type = "isaacsim.sensors.physics.IsaacReadJointState"
                    int node:typeVersion = 1
                    custom uint outputs:execOut (
                        customData = {
                            bool isExecution = 1
                        }
                    )
                    custom uchar[] outputs:jointDofTypes
                    custom double[] outputs:jointEfforts
                    custom token[] outputs:jointNames
                    custom double[] outputs:jointPositions
                    custom double[] outputs:jointVelocities
                    custom float outputs:sensorTime
                    custom float outputs:stageMetersPerUnit
                }

                def OmniGraphNode "JointStates"
                {
                    custom uint64 inputs:context
                    prepend uint64 inputs:context.connect = </World/FactoryDemo/ROS/arm_01/Context.outputs:context>
                    custom uint inputs:execIn (
                        customData = {
                            bool isExecution = 1
                        }
                    )
                    prepend uint inputs:execIn.connect = </World/FactoryDemo/ROS/arm_01/ReadJoints.outputs:execOut>
                    custom uchar[] inputs:jointDofTypes
                    prepend uchar[] inputs:jointDofTypes.connect = </World/FactoryDemo/ROS/arm_01/ReadJoints.outputs:jointDofTypes>
                    custom double[] inputs:jointEfforts
                    prepend double[] inputs:jointEfforts.connect = </World/FactoryDemo/ROS/arm_01/ReadJoints.outputs:jointEfforts>
                    custom token[] inputs:jointNames
                    prepend token[] inputs:jointNames.connect = </World/FactoryDemo/ROS/arm_01/ReadJoints.outputs:jointNames>
                    custom double[] inputs:jointPositions
                    prepend double[] inputs:jointPositions.connect = </World/FactoryDemo/ROS/arm_01/ReadJoints.outputs:jointPositions>
                    custom double[] inputs:jointVelocities
                    prepend double[] inputs:jointVelocities.connect = </World/FactoryDemo/ROS/arm_01/ReadJoints.outputs:jointVelocities>
                    custom string inputs:nodeNamespace = "arm_01"
                    custom string inputs:qosProfile
                    custom uint64 inputs:queueSize
                    custom float inputs:sensorTime
                    prepend float inputs:sensorTime.connect = </World/FactoryDemo/ROS/arm_01/ReadJoints.outputs:sensorTime>
                    custom float inputs:stageMetersPerUnit
                    prepend float inputs:stageMetersPerUnit.connect = </World/FactoryDemo/ROS/arm_01/ReadJoints.outputs:stageMetersPerUnit>
                    custom rel inputs:targetPrim (
                        customData = {
                            dictionary omni = {
                                dictionary graph = {
                                    string relType = "target"
                                }
                            }
                        }
                    )
                    custom double inputs:timeStamp
                    custom string inputs:topicName = "joint_states"
                    token node:type = "isaacsim.ros2.bridge.ROS2PublishJointState"
                    int node:typeVersion = 1
                }

                def OmniGraphNode "Commands"
                {
                    custom uint64 inputs:context
                    prepend uint64 inputs:context.connect = </World/FactoryDemo/ROS/arm_01/Context.outputs:context>
                    custom uint inputs:execIn (
                        customData = {
                            bool isExecution = 1
                        }
                    )
                    prepend uint inputs:execIn.connect = </World/FactoryDemo/ROS/arm_01/Tick.outputs:tick>
                    custom string inputs:nodeNamespace = "arm_01"
                    custom string inputs:qosProfile
                    custom uint64 inputs:queueSize = 1
                    custom string inputs:topicName = "joint_command"
                    token node:type = "isaacsim.ros2.bridge.ROS2SubscribeJointState"
                    int node:typeVersion = 2
                    custom double[] outputs:effortCommand
                    custom uint outputs:execOut (
                        customData = {
                            bool isExecution = 1
                        }
                    )
                    custom token[] outputs:jointNames
                    custom double[] outputs:positionCommand
                    custom double outputs:timeStamp
                    custom double[] outputs:velocityCommand
                }

                def OmniGraphNode "Controller"
                {
                    custom double[] inputs:effortCommand
                    prepend double[] inputs:effortCommand.connect = </World/FactoryDemo/ROS/arm_01/Commands.outputs:effortCommand>
                    custom uint inputs:execIn (
                        customData = {
                            bool isExecution = 1
                        }
                    )
                    prepend uint inputs:execIn.connect = </World/FactoryDemo/ROS/arm_01/Commands.outputs:execOut>
                    custom int[] inputs:jointIndices
                    custom token[] inputs:jointNames
