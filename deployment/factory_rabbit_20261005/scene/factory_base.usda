        def OmniGraphNode "DepthRender"
        {
            custom rel inputs:cameraPrim = </World/AgentFranka/AgentD455/RSD455/Camera_Pseudo_Depth> (
                customData = {
                    dictionary omni = {
                        dictionary graph = {
                            string relType = "target"
                        }
                    }
                }
            )
            custom bool inputs:enabled
            custom uint inputs:execIn (
                customData = {
                    bool isExecution = 1
