        def "Conveyor"
        {
            def Xform "Belt"
            {
                double3 xformOp:translate = (0.6, 0, 0.735)
                uniform token[] xformOpOrder = ["xformOp:translate"]

                def Cube "Geometry" (
                    prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysicsRigidBodyAPI", "PhysxSurfaceVelocityAPI"]
                )
                {
                    rel material:binding = </World/FactoryDemo/Cleanroom/RealisticDetails/Materials/TexturedPUConveyor>
                    rel material:binding:physics = </World/FactoryDemo/Looks/ContactRubber>
                    bool physics:kinematicEnabled = 1
                    vector3f physxSurfaceVelocity:surfaceVelocity = (0, 0.06, 0)
                    bool physxSurfaceVelocity:surfaceVelocityEnabled = 1
                    bool physxSurfaceVelocity:surfaceVelocityLocalSpace = 0
                    double size = 1
                    float3 xformOp:scale = (0.35, 5.8, 0.03)
                    uniform token[] xformOpOrder = ["xformOp:scale"]
                }

                def OmniGraph "ConveyorGraph"
                {
                    token evaluationMode = "Automatic"
                    token evaluator:type = "execution"
                    token fabricCacheBacking = "StageWithoutHistory"
                    int2 fileFormatVersion = (1, 9)
                    custom float graph:variable:Velocity = 0.06 (
                        customData = {
                            token scope = "private"
                        }
                        displayName = "Velocity"
                    )
                    token pipelineStage = "pipelineStageSimulation"

                    def OmniGraphNode "OnTick"
                    {
                        token node:type = "omni.graph.action.OnPlaybackTick"
                        int node:typeVersion = 2
                        custom double outputs:deltaSeconds
                        custom double outputs:frame
                        custom uint outputs:tick (
                            customData = {
                                bool isExecution = 1
                            }
                        )
                        custom double outputs:time
                    }

                    def OmniGraphNode "ConveyorNode"
                    {
                        custom float2 inputs:animateDirection
                        custom float inputs:animateScale
                        custom bool inputs:animateTexture
                        custom rel inputs:conveyorPrim = </World/FactoryDemo/Conveyor/Belt/Geometry> (
                            customData = {
                                dictionary omni = {
                                    dictionary graph = {
                                        string relType = "target"
                                    }
                                }
                            }
                        )
                        custom bool inputs:curved
                        custom float inputs:delta
                        prepend float inputs:delta.connect = </World/FactoryDemo/Conveyor/Belt/ConveyorGraph/OnTick.outputs:deltaSeconds>
                        custom float3 inputs:direction = (0, 1, 0)
                        custom bool inputs:enabled
                        custom uint inputs:onStep (
                            customData = {
                                bool isExecution = 1
                            }
                        )
                        prepend uint inputs:onStep.connect = </World/FactoryDemo/Conveyor/Belt/ConveyorGraph/OnTick.outputs:tick>
                        custom float inputs:velocity
                        prepend float inputs:velocity.connect = </World/FactoryDemo/Conveyor/Belt/ConveyorGraph/read_speed.outputs:value>
                        token node:type = "isaacsim.asset.gen.conveyor.IsaacConveyor"
                        int node:typeVersion = 1
                    }

                    def OmniGraphNode "read_speed"
                    {
                        custom rel inputs:graph = </World/FactoryDemo/Conveyor/Belt/ConveyorGraph> (
                            customData = {
                                dictionary omni = {
                                    dictionary graph = {
                                        string relType = "target"
                                    }
                                }
                            }
                        )
                        custom token inputs:targetPath
                        custom token inputs:variableName = "Velocity"
                        token node:type = "omni.graph.core.ReadVariable"
                        int node:typeVersion = 2
                        custom token outputs:value
                    }
                }
            }

