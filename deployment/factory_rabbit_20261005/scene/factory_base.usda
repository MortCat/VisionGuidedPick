            prepend double inputs:timeStamp.connect = </World/AgentROS2/Time.outputs:simulationTime>
            custom string inputs:topicName = "/clock"
            token node:type = "isaacsim.ros2.bridge.ROS2PublishClock"
            int node:typeVersion = 1
        }

        def OmniGraphNode "JointCommands"
        {
            custom uint64 inputs:context
            prepend uint64 inputs:context.connect = </World/AgentROS2/Context.outputs:context>
            custom uint inputs:execIn (
                customData = {
