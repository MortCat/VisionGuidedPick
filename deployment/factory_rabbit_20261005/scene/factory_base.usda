                custom string sensor:calibrationId = "factory_gantry_d455_20261012_v1"
                matrix4d xformOp:transform = ( (1.550910762415538e-16, 0.5759535324331851, -0.8174824331309729, 0), (-1, 2.842505943514056e-16, 7.845454079910857e-17, 0), (2.220446049250315e-16, 0.817483261469563, 0.5759541160353734, 0), (0.5885, -2.1200000000000006, 1.6999999999999995, 1) )
                uniform token[] xformOpOrder = ["xformOp:transform"]

                over "RSD455"
                {
