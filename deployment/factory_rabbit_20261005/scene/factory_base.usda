            custom token[] inputs:jointNames
            prepend token[] inputs:jointNames.connect = </World/AgentROS2/ReadJoints.outputs:jointNames>
            custom double[] inputs:jointPositions
            prepend double[] inputs:jointPositions.connect = </World/AgentROS2/ReadJoints.outputs:jointPositions>
            custom double[] inputs:jointVelocities
            prepend double[] inputs:jointVelocities.connect = </World/AgentROS2/ReadJoints.outputs:jointVelocities>
            custom string inputs:nodeNamespace
            custom string inputs:qosProfile
            custom uint64 inputs:queueSize
            custom float inputs:sensorTime
            prepend float inputs:sensorTime.connect = </World/AgentROS2/ReadJoints.outputs:sensorTime>
            custom float inputs:stageMetersPerUnit
            prepend float inputs:stageMetersPerUnit.connect = </World/AgentROS2/ReadJoints.outputs:stageMetersPerUnit>
            custom rel inputs:targetPrim (
                customData = {
                    dictionary omni = {
                        dictionary graph = {
                            string relType = "target"
                        }
                    }
                }
            )
            custom double inputs:timeStamp
            custom string inputs:topicName = "/joint_states"
            token node:type = "isaacsim.ros2.bridge.ROS2PublishJointState"
            int node:typeVersion = 1
        }

        def OmniGraphNode "Clock"
        {
            custom uint64 inputs:context
            prepend uint64 inputs:context.connect = </World/AgentROS2/Context.outputs:context>
