<?xml version="1.0" encoding="UTF-8"?>
<dds xmlns="http://www.eprosima.com">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>factory_udp_v4</transport_id>
        <type>UDPv4</type>
        <maxMessageSize>1400</maxMessageSize>
        <!-- Use WSL Ethernet, not its synthetic DNS address on loopback. -->
        <interfaceWhiteList><interface>eth0</interface><address>127.0.0.1</address></interfaceWhiteList>
        <!-- A saturated socket must not hold the simulation update thread. -->
        <non_blocking_send>true</non_blocking_send>
        <sendBufferSize>4194304</sendBufferSize>
        <receiveBufferSize>4194304</receiveBufferSize>
      </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="factory_udp_participant" is_default_profile="true">
      <rtps>
        <userTransports><transport_id>factory_udp_v4</transport_id></userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
